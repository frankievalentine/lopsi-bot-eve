[
  {
    "id": "agentphone",
    "name": "AgentPhone",
    "description": "SMS, MMS, iMessage, and voice conversations through AgentPhone.",
    "package": "@agentphone/chat-sdk-adapter",
    "factory": "createAgentPhoneAdapter",
    "adapter": "agentphone",
    "streaming": false,
    "options": {
      "apiKey": {
        "env": "AGENTPHONE_API_KEY"
      },
      "agentId": {
        "env": "AGENTPHONE_AGENT_ID"
      },
      "webhookSecret": {
        "env": "AGENTPHONE_WEBHOOK_SECRET"
      }
    },
    "env": [
      {
        "name": "AGENTPHONE_API_KEY",
        "secret": true
      },
      {
        "name": "AGENTPHONE_AGENT_ID",
        "secret": false
      },
      {
        "name": "AGENTPHONE_WEBHOOK_SECRET",
        "secret": true
      }
    ],
    "senders": "phone numbers in +E.164"
  },
