{
  "name": "lopsi-bot-eve",
  "version": "0.0.0",
  "private": true,
  "description": "Lopsi Bot for eve: a crew of eve agents with the Lopsi dashboard.",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#lopsi/*": "./agents/lopsi/agent/*"
  },
  "scripts": {
    "build": "pnpm run build:agent && pnpm run build:web",
    "build:agent": "eve build",
    "build:web": "next build apps/web",
    "check": "ultracite check",
    "crew": "node scripts/crew.mjs",
    "deploy": "eve deploy",
    "dev:agent": "eve dev --agent lopsi",
    "dev:all": "vercel dev --local",
    "dev:web": "next dev apps/web",
    "eval": "eve eval --agent lopsi",
    "fix": "ultracite fix",
    "knip": "knip",
    "setup:channel": "node scripts/setup-channel.mjs",
    "setup:connector": "node scripts/setup-connector.mjs",
    "setup:email": "node scripts/setup-email.mjs",
    "setup:sign-in": "node scripts/setup-sign-in.mjs",
    "start": "eve start",
    "typecheck": "tsc && tsc -p apps/web",
    "validate": "node scripts/crew.mjs --check && pnpm run check && pnpm run typecheck && pnpm run knip && eve info --agent lopsi"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@chat-adapter/state-memory": "4.43.0",
    "@chat-adapter/state-redis": "4.43.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@resend/chat-sdk-adapter": "^0.5.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/connect": "2.7.0",
    "@vercel/oidc": "4.0.5",
    "ai": "^7.0.137",
    "better-auth": "1.6.26",
    "chat": "4.43.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.5.2",
    "eve": "1.0.0-rc.3",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "nanoid": "^6.0.2",
    "next": "16.3.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "streamdown": "^2.7.1",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "just-bash": "^3.6.0",
    "knip": "^6.44.1",
    "typescript": "6.0.3",
    "ultracite": "^8.1.1"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  }
}
