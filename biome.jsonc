{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!apps/web/next-env.d.ts",
      // Vendored from the shadcn and AI Elements registries by `eve add channel/web`.
      "!apps/web/components/ui",
      "!apps/web/components/ai-elements",
      "!apps/web/app/shadcn-tailwind.css",
      // Copied unchanged from lopsi-bot's apps/web; keep them in step with it there.
      "!apps/web/components/mascot.tsx",
      "!apps/web/components/crew-icon.tsx",
      "!apps/web/components/l-mark.tsx",
      "!apps/web/lib/favicon.tsx",
      "!apps/web/lib/utils.ts",
      "!apps/web/public",
      // Generated by scripts/crew.mjs; `pnpm crew --check` compares it byte for byte.
      "!apps/web/lib/crew.generated.ts",
      // Written by the dashboard as JSON.stringify output (lib/crew-core.mjs) and
      // validated by `pnpm crew`; reformatting would make its edits fail the check.
      "!agents/*/crew.json"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        // Inline handlers are fine here: no child is memoized, so useCallback would
        // add noise without saving renders.
        "noJsxPropsBind": "off"
      },
      "suspicious": {
        // Its type inference reads React state and refs as their initial values
        // (useRef(false) as always false), so it flags live conditions.
        "noUnnecessaryConditions": "off"
      },
      "style": {
        // eve derives tool, connection and skill names from filenames, and those
        // names use snake_case (e.g. agents/lopsi/agent/tools/get_user_preferences.ts).
        "useFilenamingConvention": "off"
      }
    }
  }
}
