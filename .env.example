# Starter mode (Settings shows it as Shared Password): the password visitors
# enter before they reach the crew. At least 16 characters; a shorter one keeps
# the deployment locked. Generate one with: openssl rand -base64 32
# Leave it unset locally to open the chat without a password.
LOPSI_ACCESS_PASSWORD=

# Production mode: Sign in with Vercel, limited to the project's team.
# `pnpm setup:sign-in` creates the Vercel App and writes these to production
# and preview; don't set them by hand. Once they're set, LOPSI_ACCESS_PASSWORD
# is no longer accepted, even before the Blob store below is connected.
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# The private Blob store: chat owners and history in production mode, sender
# allowlists, approved service hosts and memory. The Deploy button connects
# one; `pnpm setup:sign-in` creates it if it's missing. BLOB_READ_WRITE_TOKEN
# works in its place.
BLOB_STORE_ID=

# A Vercel access token for this team, so Lopsi can list the connectors
# attached to the project in Vercel Connect, and Settings can turn on email and
# change the budget. Read on the server only. Without it the crew has no
# connectors.
VERCEL_TOKEN=

# Changing the crew from the dashboard: the Vercel Connect GitHub App connector
# the Deploy button adds. Unset, any GitHub connector attached to the project
# is used; with none, the feature is off.
GITHUB_CONNECTOR=
# Where pull requests go. On Vercel these come from the Git deployment; set
# them locally, or to override.
LOPSI_GITHUB_REPO=
LOPSI_GITHUB_BRANCH=

# Spend per chat window, in US dollars, before it stops and asks Continue or
# Stop. Leave unset for $1. On Vercel, Settings > Usage can change it.
LOPSI_SESSION_BUDGET_USD=

# Email through a Resend connector. Settings > Integrations > Turn On sets
# LOPSI_EMAIL_DOMAIN and redeploys; each crew member answers
# <member>@LOPSI_EMAIL_DOMAIN. Receiving also needs Redis for threads
# (REDIS_URL or KV_URL, from Upstash for Redis).
LOPSI_EMAIL_DOMAIN=
REDIS_URL=
# Optional: trust Authentication-Results only from this receiving server.
LOPSI_EMAIL_AUTHSERV_ID=

# Who may email or message the crew, in addition to the lists edited in
# Settings > Integrations (kept in the Blob store). Comma-separated; entries
# here can't be removed from Settings. Email: addresses and whole domains
# (@example.com), and the mail must also pass DMARC. Telegram: usernames or
# numeric user ids. With both lists empty, nobody gets through.
LOPSI_EMAIL_SENDERS=
LOPSI_TELEGRAM_SENDERS=

# Set to 1 to show the demo: prewritten replies, no model and no sign-in.
NEXT_PUBLIC_LOPSI_DEMO=
