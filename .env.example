# Starter mode: the password visitors enter before they reach the crew.
# At least 16 characters; a shorter one keeps the deployment locked.
# Generate one with: openssl rand -base64 32
# Leave it unset locally to open the chat without a password.
LOPSI_ACCESS_PASSWORD=

# Production mode: Sign in with Vercel, limited to the project's team.
# `eve add channel/web` (Sign in with Vercel) creates the Vercel App and writes
# these to production and preview; don't set them by hand. When all three are
# present they take precedence and LOPSI_ACCESS_PASSWORD is ignored.
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# Production mode also needs the private Blob store that keeps each chat to the
# person who started it. `pnpm setup:sign-in` creates and connects it.
BLOB_STORE_ID=

# Connectors: the Vercel Connect connector UID for each service you set up with
# `pnpm setup:connector <name>`. Leave unset to keep a service off.
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=

# Changing the crew from the dashboard: the Vercel Connect GitHub App connector
# from `pnpm setup:connector github`. Leave unset to turn the feature off.
GITHUB_CONNECTOR=
# Where pull requests go. On Vercel these come from the Git deployment; set
# them locally, or to override.
LOPSI_GITHUB_REPO=
LOPSI_GITHUB_BRANCH=
